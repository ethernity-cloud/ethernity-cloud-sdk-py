        self.trustedzone_public_key_pem = ''
        self.trustedzone_image_hash = ''
        self.trustedzone_composer_hash = ''
    @staticmethod
    def generate_cert_from_mrenclave():
        logging.info("Generating self-signed certificate based on MR_ENCLAVE (no CAS available)")
        # Load the SGX library using ctypes
        sgx_lib_path = '/etny-securelock/get_sgx_report.so'
        if not os.path.exists(sgx_lib_path):
            raise FileNotFoundError(f"SGX library not found at {sgx_lib_path}")
        sgx_lib = ctypes.CDLL(sgx_lib_path)
        sgx_lib.get_mr_enclave.restype = ctypes.c_char_p
        sgx_lib.get_mr_signer.restype = ctypes.c_char_p
        sgx_lib.derive_identity_scalar.restype = ctypes.c_char_p
        sgx_lib.derive_identity_scalar.argtypes = [ctypes.c_int]

        # Get MR_ENCLAVE (for the cert extension / log) from the module.
        mr_enclave_ptr = sgx_lib.get_mr_enclave()
        if not mr_enclave_ptr:
            raise ValueError("Failed to retrieve MR_ENCLAVE from SGX")
        mr_enclave_hex = mr_enclave_ptr.decode('utf-8')
        logging.info(f"MR_ENCLAVE: {mr_enclave_hex}")

        # Identity-key derivation now lives ENTIRELY in the compiled module
        # (get_sgx_report.so). derive_identity_scalar(role) returns the 96-hex
        # secp384r1 scalar; role 0 = SecureLock. The algorithm (HKDF-SHA512,
        # domain tags, 4096-round stretch, rejection sampling) is not present in
        # this interpreted source -- it is in the .so only, so reading the
        # Python reveals nothing about how the key is derived. The .c source of
        # truth lives in the etny-pynithy / etny-nodenithy repos; the SDK ships
        # only the built .so.
        ROLE_SECURELOCK = 0
        scalar_ptr = sgx_lib.derive_identity_scalar(ROLE_SECURELOCK)
        if not scalar_ptr:
            raise ValueError("derive_identity_scalar failed in the SGX module")
        private_value = int(scalar_ptr.decode('utf-8'), 16)

        curve = ec.SECP384R1()
        private_key = ec.derive_private_key(private_value, curve, default_backend())
        public_key = private_key.public_key()

        # Custom extension for MR_ENCLAVE
        custom_oid = x509.ObjectIdentifier("1.3.6.1.4.1.99999.1")  # Arbitrary custom OID
        mr_enclave_value = mr_enclave_hex.encode('utf-8')

        # Build certificate
        one_day = timedelta(days=1)
        builder = x509.CertificateBuilder()
        builder = builder.subject_name(x509.Name([x509.NameAttribute(NameOID.COMMON_NAME, u"SecureLock Enclave")]))
        builder = builder.issuer_name(x509.Name([x509.NameAttribute(NameOID.COMMON_NAME, u"SecureLock Enclave")]))
        builder = builder.not_valid_before(datetime.datetime.today() - one_day)
        builder = builder.not_valid_after(datetime.datetime.today() + (one_day * 365))
        builder = builder.serial_number(x509.random_serial_number())
        builder = builder.public_key(public_key)
        builder = builder.add_extension(
            UnrecognizedExtension(custom_oid, mr_enclave_value),
            critical=False
        )
        certificate = builder.sign(
            private_key=private_key,
            algorithm=hashes.SHA256(),
            backend=default_backend()
        )
        # Store in memory instead of writing to disk
        private_key_pem = private_key.private_bytes(
            encoding=serialization.Encoding.PEM,
            format=serialization.PrivateFormat.PKCS8,
            encryption_algorithm=serialization.NoEncryption()
        )
        cert_pem = certificate.public_bytes(encoding=serialization.Encoding.PEM)
        logging.info("Generated key and cert in memory based on MR_ENCLAVE")
        return private_key_pem, cert_pem

    @staticmethod
    def read_env_str(env_str: str):
        with io.StringIO(env_str) as f:
            for line in f:
                if '=' not in line:
                    continue
                key, value = line.split('=', 1)
                os.environ[key.strip()] = re.sub(r'\n', '', value.strip())
    def validate_client_payload(self):
        payload_data = self.__get_file_content_and_decrypt(self.payload)
        input_data = self.__get_file_content_and_decrypt(self.input)
        max_retries = 5
        for attempt in range(max_retries):
            try:
                self.get_do_request_metadata()
                break
            except Exception as e:
                if attempt == max_retries - 1:
                    self.task_code = TaskStatus.METADATA_FETCH_ERROR
                    self.task_result = f'Failed to fetch metadata after {max_retries} attempts: {str(e)}'
                    self.is_valid_client_data = False
                    return
        # Assume is_valid_client_data is False by default; we'll set to True only if all checks pass.

        def validate_checksum(metadata_obj, data, owner, error_code, error_msg):
            """Validate one file's integrity against its on-chain checksum (v4).

            The DO-request is submitted on-chain by the owner, so the metadata
            checksum is already authenticated by the transaction sender; we only
            need to confirm the file content hashes to that recorded checksum.
            Kept identical to the trustedzone enclave so both agree.
            """
            checksum = self.compute_sha256_checksum(data)
            tx_checksum = metadata_obj.checksum.lower().removeprefix('0x')

            if tx_checksum != checksum:
                self.task_code = error_code
                self.task_result = error_msg
                return False
            return True

        owner = self.order_metadata.do_owner.lower()

        # Payload is always required and always carries a checksum.
        if self._metadata.payload_metadata_obj.has_checksum:
            try:
                payload_valid = validate_checksum(
                    self._metadata.payload_metadata_obj, payload_data, owner,
                    TaskStatus.PAYLOAD_CHECKSUM_ERROR, 'PAYLOAD CHECKSUM DOESN\'T MATCH')
            except Exception:
                self.task_code = TaskStatus.PAYLOAD_CHECKSUM_ERROR
                self.task_result = 'PAYLOAD CHECKSUM CHECK ERROR'
                payload_valid = False
        else:
            self.task_code = TaskStatus.PAYLOAD_CHECKSUM_ERROR
            self.task_result = 'PAYLOAD CHECKSUM DOESN\'T EXIST'
            payload_valid = False

        # Empty input carries no checksum -> nothing to validate.
        if not self._metadata.input_metadata_obj.has_checksum:
            input_valid = True
        else:
            try:
                input_valid = validate_checksum(
                    self._metadata.input_metadata_obj, input_data, owner,
                    TaskStatus.INPUT_CHECKSUM_ERROR, 'INPUT CHECKSUM DOESN\'T MATCH')
            except Exception:
                self.task_code = TaskStatus.INPUT_CHECKSUM_ERROR
                self.task_result = 'INPUT CHECKSUM CHECK ERROR'
                input_valid = False

        if payload_valid and input_valid:
            self.is_valid_client_data = True
    def wait_for_payload_and_input(self):
        logging.info('Waiting for payload and input')
        self.wait_for_trustedzone(self.etny_bucket, self.payload)
        self.wait_for_trustedzone(self.etny_bucket, self.input)

    def wait_for_trustedzone(self, bucket_name: str, object_name: str, timeout: int = 3600):
        i = 0
        logging.info(f'Checking if object {object_name} exists in bucket {bucket_name}')
        while i < timeout:
            time.sleep(1)
            i += 1
            status, _ = self.swift_stream_service.is_object_in_bucket(bucket_name, object_name)
            if status:
                break
        logging.info('trusted zone finished the upload')
    def get_do_request_metadata(self):
        order = Order(self.etny.caller()._getOrder(self.order_id), self.order_id)
        self._metadata = DOReqMetadata(self.etny.caller()._getDORequestMetadata(order.do_req), order.do_req)
        self.order_metadata = order
    def compute_sha256_checksum(self, file_data: str) -> str:
        if isinstance(file_data, str):
            file_data = file_data.encode('utf-8')
        return hashlib.sha256(file_data).hexdigest()

    def print_env(self):
        logging.info(f'chain id: {self.chain_id}')
        logging.info(f'smart contract address: {self.smart_contract_address}')
        logging.info(f'web3 provider: {self.web3_provider}')
        logging.info(f'order id: {self.order_id}')
    def init_web3(self):
        self.w3 = Web3(Web3.HTTPProvider(self.web3_provider))
        self.w3.middleware_onion.inject(ExtraDataToPOAMiddleware, layer=0)
        self.etny = self.w3.eth.contract(address=self.smart_contract_address,
                                         abi=self.contract_abi)
        self.image_registry = self.w3.eth.contract(address=self.image_registry_address,
                                                   abi=self.image_registry_abi)

    def verify_cas_attestation(self):
        """
        Verify the CAS that provisioned this enclave (the OUTBOUND half of
        trust; the CAS attesting us is the inbound half).

        The CAS injects ECAS_CAS_QUOTE into the session environment -- a DCAP
        quote whose report_data binds its EGETKEY validator address (bytes
        0:20) and the SHA-256 of its certificate (bytes 20:52). We check it
        against the ValidatorRegistry baked into this build: the address must
        be an ACTIVE validator, the quote MRENCLAVE must equal that
        validator's registered measurement, and the bound cert hash must
        equal the registered certHash. Evicting a CAS on-chain therefore
        revokes it HERE on the next task, without redeploying enclaves.

        Rollout is LOG-ONLY by default; ECAS_CAS_ATTEST_MODE=enforce (from
        the session) flips failures into refusal. Debug-signed CAS quotes are
        tolerated on testnet builds only. The quote's ECDSA/PCK signature
        chain is NOT yet verified in-enclave; what this binds is
        quote-contents <-> on-chain record, which is the revocation path.
        """
        registry = self.validator_registry_address
        mode = os.environ.get('ECAS_CAS_ATTEST_MODE', 'log').lower()
        self.cas_attestation_fault = None

        def fault(reason):
            # INVALID evidence: the operator provisioned this task through an
            # impostor CAS. Recorded here and adjudicated in execute() before
            # the payload runs -- the task then terminates with
            # CAS_ATTESTATION_FAULT and the order is refunded.
            logging.error(f'CAS ATTESTATION INVALID: {reason}')
            self.cas_attestation_fault = reason

        def soft(reason):
            # Absence or unreachability: a rollout gap or a chain outage, not
            # proof of malice. Log-only, unless enforcement is on.
            if mode == 'enforce':
                fault(reason)
            else:
                logging.warning(f'CAS ATTESTATION (log-only) FAILED: {reason}')

        if not registry or registry.startswith('__'):
            logging.info('CAS attestation: no ValidatorRegistry for this network; skipping')
            return
        quote_b64 = os.environ.get('ECAS_CAS_QUOTE', '')
        if not quote_b64:
            return soft('no ECAS_CAS_QUOTE in the session environment (unattested CAS)')
        try:
            quote = base64.b64decode(quote_b64)
        except Exception as e:
            return fault(f'ECAS_CAS_QUOTE is not valid base64: {e}')
        # DCAP quote layout: 48-byte header, then the report body --
        # ATTRIBUTES at body+48 (16), MRENCLAVE at body+64 (32),
        # report_data at body+320 (64).
        if len(quote) < 48 + 384:
            return fault(f'quote too short ({len(quote)} bytes)')
        attributes = quote[96:112]
        quote_mrenclave = quote[112:144].hex()
        report_data = quote[368:432]
        cas_address = self.w3.to_checksum_address('0x' + report_data[0:20].hex())
        bound_cert = report_data[20:52].hex()

        vr_abi = [
            {"name": "isValidator", "type": "function", "stateMutability": "view",
             "inputs": [{"type": "address"}], "outputs": [{"type": "bool"}]},
            {"name": "validators", "type": "function", "stateMutability": "view",
             "inputs": [{"type": "address"}],
             "outputs": [{"name": "mrenclave", "type": "bytes32"},
                         {"name": "certHash", "type": "bytes32"},
                         {"name": "active", "type": "bool"},
                         {"name": "admittedBlock", "type": "uint64"},
                         {"name": "lastVoteBlock", "type": "uint64"}]},
        ]
        try:
            vr = self.w3.eth.contract(address=self.w3.to_checksum_address(registry),
                                      abi=vr_abi)
            active = vr.caller().isValidator(cas_address)
            record = vr.caller().validators(cas_address)
        except Exception as e:
            return soft(f'ValidatorRegistry {registry} unreachable: {e}')
        if not active:
            return fault(f'CAS {cas_address} is NOT an active validator')
        registered_mr = record[0].hex()
        if registered_mr != quote_mrenclave:
            return fault(f'CAS quote MRENCLAVE {quote_mrenclave} != registered {registered_mr}')
        registered_cert = record[1].hex()
        if registered_cert != '00' * 32 and registered_cert != bound_cert:
            return fault(f'CAS quote cert hash {bound_cert} != registered {registered_cert}')
        # SGX ATTRIBUTES.FLAGS bit 1 = DEBUG. A debug CAS protects nothing;
        # testnet builds tolerate it (the whole testnet chain is debug).
        if (attributes[0] & 0x02) and '__NETWORK_TYPE__' != 'testnet':
            return fault('CAS enclave runs in SGX DEBUG mode')
        logging.info(f'CAS ATTESTATION VERIFIED: validator {cas_address}, '
                     f'MRENCLAVE {quote_mrenclave[:16]}..., certificate bound on-chain')

    def read_contract_abi(self):
        self.contract_abi = self.__read_contract_abi('abi/etnyImplementationV2.abi')
        self.image_registry_abi = self.__read_contract_abi('abi/image_registry.abi')
    def __read_contract_abi(self, contract_name: str) -> str:
        path = os.path.join(os.path.dirname(os.path.realpath(__file__)), contract_name)
        with open(path, 'r') as f:
            return f.read()
    def __load_env(self):
        if os.getenv('ETNY_CHAIN_ID'):
            self.chain_id = int(os.getenv('ETNY_CHAIN_ID'))
        if os.getenv('ETNY_SMART_CONTRACT_ADDRESS'):
            self.smart_contract_address = os.getenv('ETNY_SMART_CONTRACT_ADDRESS').rstrip()
        if os.getenv('ETNY_WEB3_PROVIDER'):
            self.web3_provider = os.getenv('ETNY_WEB3_PROVIDER').rstrip()
        self.order_id = int(os.getenv('ETNY_ORDER_ID'))

    def save_result(self):
        self.encrypt_file_and_push_to_swifstream(str(self.task_result), self.result)
        self.encrypt_file_and_push_to_swifstream(str(self.task_code), self.result_code)
    def save_pub_cert(self):
        self.swift_stream_service.create_bucket(self.etny_bucket)
        if self.cert_pem:
            data = io.BytesIO(self.cert_pem)
            self.swift_stream_service.put_file_content(self.etny_bucket,
                                                       "cert.pem",
                                                       "",
                                                       data)
    def save_transaction(self):
        self.swift_stream_service.create_bucket(self.etny_bucket)
        transaction = io.BytesIO(self.signed_tx_as_bytes)
        self.swift_stream_service.put_file_content(self.etny_bucket,
                                                   "transaction.txt",
                                                   self.transaction_file,
                                                   transaction)
    def execute(self):
        # ADJUDICATE the CAS attestation verdict recorded at startup. An
        # INVALID CAS quote terminates the task before the payload runs; the
        # failure reporter writes the CAS_ATTESTATION_FAULT result the
        # trustedzone forwards on-chain -- the refundable operator-fault path.
        if getattr(self, 'cas_attestation_fault', None):
            self.task_code = TaskStatus.CAS_ATTESTATION_FAULT
            self.task_result = (
                f'CAS_ATTESTATION_FAULT: {self.cas_attestation_fault} -- the '
                f'operator provisioned this task through a CAS that failed '
                f'self-attestation; order terminated for refund.')
            raise ValueError(self.task_result)
        self.payload_data = self.__get_file_content_and_decrypt(self.payload)
        self.input_data = self.__get_file_content_and_decrypt(self.input)
        self.payload_signature = self.__get_file_content_and_decrypt(self.payload + ".sig")
        self.input_signature = self.__get_file_content_and_decrypt(self.input + ".sig")

        self.validate_trustedzone_data()
        self.configure_state_registry()
        # Interactive session: the trustedzone stages session.config when the
        # request asked for one; the executor keeps the payload context alive,
        # streams inputs/outputs, and finalizes with a SUCCESS summary when
        # the running period completes (see etny_session_exec).
        status, _ = self.swift_stream_service.is_object_in_bucket(
            self.etny_bucket, 'session.config.securelock')
        if status:
            from etny_session_exec import run_session
            logging.info('Interactive session mode')
            task_result = run_session(self)
        else:
            task_result = execute_task_v3(self.payload_data, self.input_data)

        self.task_code = str(task_result[0])
        self.task_result = task_result[1]

        # Post-payload: re-assert the attested caller across the ESR ledger from
        # THIS securelock's private copy (self.task_caller), captured before the
        # payload ran and never handed to the payload's exec globals. Corrects
        # any callerUsed the payload may have forged so the trustedzone reads the
        # truth, and -- if a forgery is detected -- fails the task locally too.
        # Defence in depth; the trustedzone (separate enclave) and the caller
        # bound into each commit's CID remain the authoritative layers.
        try:
            import ecld_state
            if ecld_state.restamp_ledger_caller(getattr(self, "task_caller", None)):
                logging.error(
                    "ESR ledger caller was tampered with by the payload -- "
                    "failing the task (SECURITY_VIOLATION).")
                self.task_code = str(TaskStatus.SECURITY_VIOLATION)
                self.task_result = (
                    "SECURITY_VIOLATION: the task attempted to forge the state "
                    "commit caller. The attested submitter was re-asserted and "
                    "the task was terminated.")
        except Exception as e:
            logging.error(f"ESR ledger re-stamp skipped: {e}")

    def configure_state_registry(self):
        """Make StateRegistry usable from payload code, if ESR is enabled.

        Wires the module to this enclave's identity key, the SwiftStream client
        and bucket the node shares with us, the registry address baked in at
        build time, and web3. Payload code then just does:

            from ecld_state import StateRegistry
            StateRegistry().commit("key", lambda s: ...)

        No-op when ESR is disabled (no ESR_CONTRACT_ADDRESS baked in), so
        non-ESR enclaves are completely unaffected.

        Never raises: a state-registry setup problem must not stop the task from
        running. Payload code that then uses StateRegistry gets a clear error
        from the registry itself rather than a task that died before starting.
        """
        contract_address = os.getenv("ESR_CONTRACT_ADDRESS", "").strip()
        if not contract_address:
            return
        try:
            import ecld_state

            ecld_state.configure(
                identity_priv=self.private_key_pem,
                swift_stream_service=self.swift_stream_service,
                bucket=self.etny_bucket,
                contract_address=contract_address,
                web3=self.w3,
                caller=getattr(self, "task_caller", None),
            )
            logging.info(f"StateRegistry ready (ESR {contract_address})")
        except Exception as e:
            logging.error(f"ESR_STATE_ERROR: could not configure StateRegistry: {e}")

    def validate_trustedzone_data(self):
        """
        Validates signatures of payload and input from trustedzone using the trustedzone public key.
        """
        # Validate payload signature

        self.__get_trustedzone_public_key()

        logging.debug(f"Trustedzone Public Key (hex): {self.trustedzone_public_key}")

        sig_der_payload = bytes.fromhex(self.payload_signature)
        logging.debug(f"Signature DER (hex): {sig_der_payload.hex()}")
        if not crypto.verify_signature(self.trustedzone_public_key, self.payload_data.encode('utf-8'), sig_der_payload):
            logging.error("Payload signature validation failed")
            raise ValueError('INVALID PAYLOAD SIGNATURE')  # Or set error state as needed

        # Validate input signature
        sig_der_input = bytes.fromhex(self.input_signature)
        if not crypto.verify_signature(self.trustedzone_public_key, self.input_data.encode('utf-8'), sig_der_input):
            logging.error("Input signature validation failed")
            raise ValueError('INVALID INPUT SIGNATURE')  # Or set error state as needed

        logging.info("Trustedzone signatures validated successfully")

        # Authenticated task caller: the DO-request owner, read from the PoX
        # contract by the TRUSTEDZONE and forwarded over this same signed
        # channel (caller.securelock + .sig). Optional -- an older trustedzone
        # does not send it, and the state ACL then treats the task as
        # anonymous. NEVER accepted without a valid trustedzone signature.
        self.task_caller = None
        try:
            caller_value = self.__get_file_content_and_decrypt('caller.securelock')
            caller_sig = self.__get_file_content_and_decrypt('caller.securelock.sig')
            if crypto.verify_signature(
                    self.trustedzone_public_key,
                    caller_value.encode('utf-8'),
                    bytes.fromhex(caller_sig)):
                self.task_caller = caller_value.strip()
                logging.info(f"Task caller attested by trustedzone: {self.task_caller}")
            else:
                logging.error(
                    "caller.securelock signature validation FAILED; "
                    "treating task as anonymous")
        except Exception as e:
            logging.info(
                f"No attested task caller supplied "
                f"({e.__class__.__name__}); treating task as anonymous")

    def get_and_verify_trustedzone_object(self, object_name: str) -> str:
        """Decrypt a trustedzone-pushed object and verify its signature --
        the same trust checks the payload/input handoff gets. Raises on any
        failure so the session never consumes unauthenticated data."""
        data = self.__get_file_content_and_decrypt(object_name)
        sig_hex = self.__get_file_content_and_decrypt(object_name + '.sig')
        if not crypto.verify_signature(self.trustedzone_public_key,
                                       data.encode('utf-8'),
                                       bytes.fromhex(sig_hex)):
            raise ValueError(f"trustedzone signature invalid for {object_name}")
        return data

    def __get_file_content_and_decrypt(self, object_name: str) -> str:
        encrypted_base64 = self.__get_file_content(object_name)

        encrypted_tuple = crypto.encrypted_data_from_base64_json(encrypted_base64.encode('utf-8'))
        decrypted_result = crypto.decrypt(self.private_key_pem, encrypted_tuple)
        return decrypted_result.decode('utf-8')

    def __get_file_content(self, object_name: str) -> str:
        status, content = self.swift_stream_service.get_file_content(self.etny_bucket, object_name)
        if not status:
            raise ValueError(f'Failed to get {object_name} file')
        return content
    def encrypt_file_and_push_to_swifstream(self, file_data: str, file_name: str):
        """
        Encrypts data with trustedzone pubkey, signs the original data with our private key,
        encrypts the signature, and uploads both to storage in separate files.
        """
        # Encrypt the data
        encrypted_input = crypto.encrypt_with_pub_key(self.trustedzone_public_key_pem, file_data.encode('utf-8'))
        encrypted_input_base64 = crypto.encrypted_data_to_base64_json(encrypted_input)
        data_file_name = file_name

        # Sign the original data
        sig_der = crypto.sign_data(self.private_key_pem, file_data.encode('utf-8'))
        sig_hex = sig_der.hex()

        # Encrypt the signature
        encrypted_sig = crypto.encrypt_with_pub_key(self.trustedzone_public_key_pem, sig_hex.encode('utf-8'))
        encrypted_sig_base64 = crypto.encrypted_data_to_base64_json(encrypted_sig)
        sig_file_name = file_name + '.sig'

        # Upload encrypted data
        self.swift_stream_service.create_bucket(self.etny_bucket)
        data_io = io.BytesIO(encrypted_input_base64)
        status, _ = self.swift_stream_service.put_file_content(self.etny_bucket, data_file_name, "", data_io)
        if status:
            logging.info(f'File {data_file_name} encrypted and saved to swift stream successfully')

        # Upload encrypted signature
        sig_io = io.BytesIO(encrypted_sig_base64)
        status_sig, _ = self.swift_stream_service.put_file_content(self.etny_bucket, sig_file_name, "", sig_io)
        if status_sig:
            logging.info(f'Signature file {sig_file_name} encrypted and saved to swift stream successfully')

    def __get_trustedzone_public_key(self):
        logging.info('Getting the public key of the trusted zone enclave')
        image_name = self._metadata.trustedzone_image_name
        self.trustedzone_image_hash, self.trustedzone_public_key_pem, self.trustedzone_composer_hash = self.image_registry.caller().getLatestTrustedZoneImageCertPublicKey(image_name, 'v3')

        # Parse PEM to extract raw public key hex (x + y coordinates, no '04' prefix)
        from cryptography.x509 import load_pem_x509_certificate
        cert = load_pem_x509_certificate(self.trustedzone_public_key_pem.encode('utf-8'), default_backend())
        pub_key = cert.public_key()
        pub_bytes = pub_key.public_bytes(
            encoding=serialization.Encoding.X962,
            format=serialization.PublicFormat.UncompressedPoint
        )[1:]  # Slice off the '04' uncompressed prefix for raw format
        self.trustedzone_public_key = pub_bytes.hex()

        logging.debug(f'Extracted trustedzone public key hex: {self.trustedzone_public_key[:20]}...')  # Log snippet for confirmation
        

def _report_failure(app, exc):
    """Best-effort: write a failure result so the trustedzone stops waiting.

    Securelock only publishes the result (and its code); the trustedzone reads
    those and builds the signed transaction. Guarded throughout -- this runs
    while already handling a failure, so it must never raise or hang. If the
    enclave died before it had enough state (no app, no keys), there is nothing
    publishable and we exit quietly.
    """
    if app is None:
        logging.error("cannot report failure: enclave died before initialization")
        return
    try:
        # Preserve a specific code if one was already set (checksum mismatch,
        # metadata fetch, ...); fall back to SYSTEM_ERROR for anything else.
        if not getattr(app, 'task_code', None):
            app.task_code = TaskStatus.SYSTEM_ERROR
        if not getattr(app, 'task_result', None):
            app.task_result = f'ENCLAVE ERROR: {exc}'
        app.save_result()
        logging.info(f"failure reported (task_code={app.task_code})")
    except Exception as report_exc:
        logging.error(f"could not report the failure result: {report_exc}")


if __name__ == '__main__':
    network_type = '__NETWORK_TYPE__'
    logging.info(f'[SecureLock] Initializing enclave for {network_type}')

    # Determine paths based on debug mode
    key_file = "/private/__SECURELOCK_SESSION__/key.pem"
    cert_file = "/app/__SECURELOCK_SESSION__/cert.pem"
    pub_cert_file = "/app/__SECURELOCK_SESSION__/enclave_pub_cert.pem"
    # Load if files exist, otherwise generate
    if network_type == 'mainnet' and os.path.exists(key_file) and os.path.exists(cert_file):
        logging.info("Loading key and cert from session")
        with open(key_file, 'r+b') as f:
            private_key_pem = f.read()
            f.truncate(0)
        with open(cert_file, 'rb') as f:
            cert_pem = f.read()
    elif network_type == 'testnet':
        logging.info("No existing key/cert files found")
        private_key_pem, cert_pem = EtnySecureLock.generate_cert_from_mrenclave()
    else:
        logging.error(f"Invalid encalve session or network type")
        exit(1)

    # Emit the enclave public certificate IMMEDIATELY, before touching
    # SwiftStream. The public-key extraction service runs securelock in an
    # environment with NO etny-swift-stream (MinIO) container; the first
    # SwiftStream call below (get_file_content for .env) then blocks on a TCP
    # connect to a non-existent host with no timeout, so the enclave hangs and
    # the extractor's getPublicKey times out WITHOUT ever receiving the cert.
    # The cert is already in hand (generated from MR_ENCLAVE above / loaded from
    # the CAS session) and needs nothing from SwiftStream, so print it first.
    # Real task runs also benefit: the cert is available up-front and the same
    # PUBLIC_CERT line is still printed in the except handler for compatibility.
    logging.info(f"PUBLIC_CERT: {cert_pem.decode('utf-8')}")

    # ESR (RFC §5.2): emit the enclave's ESR wallet ADDRESS on the same channel
    # as the cert, so publish can capture it locally or via the remote
    # extraction service. It MUST be derived here rather than by the extraction
    # service: on mainnet the identity key is CAS-provisioned and exists only
    # inside this enclave, so nobody outside can compute the address. Only the
    # address is emitted — the private key never leaves.
    if os.getenv("ESR_CONTRACT_ADDRESS", "").strip():
        try:
            esr_address = esr_wallet.derive_wallet_address(private_key_pem)
            logging.info(f"ESR_WALLET_ADDRESS: {esr_address}")
            if not esr_wallet.is_secret_identity(network_type):
                logging.warning(esr_wallet.INSECURE_IDENTITY_WARNING)
        except Exception as e:
            # Never let ESR derivation break a task: report it the way every
            # other enclave-side config problem is reported.
            logging.error(f"ESR_WALLET_ERROR: {e}")

    # Cert-harvest (public-key extraction) mode: the extraction service runs
    # securelock with NO SwiftStream and NO task, purely to read the PUBLIC_CERT
    # printed above. In that environment the .env fetch below fails (no MinIO).
    # The cert is already out, so EXIT(0) cleanly instead of proceeding to
    # wait_for_payload_and_input() -- which would block forever waiting for a task
    # that never comes, hanging the extractor until its 20-minute timeout. (The
    # extractor captures the cert from stdout when this process exits.)
    try:
        swiftStreamClient = SwiftStreamService("etny-swift-stream:9000", "swiftstreamadmin", "swiftstreamadmin")
        status, env_content = swiftStreamClient.get_file_content("__BUCKET_NAME__", ".env")
    except Exception as e:
        logging.info(f"SwiftStream unavailable ({e}); public key emitted, exiting (cert-harvest mode)")
        exit(0)
    if not status:
        logging.info("No .env in SwiftStream; public key emitted, exiting (cert-harvest mode)")
        exit(0)

    try:
        EtnySecureLock.read_env_str(env_content)

        app = EtnySecureLock(cert_pem, private_key_pem, swiftStreamClient)

        logging.info('Waiting for payload and input')
        app.wait_for_payload_and_input()

        logging.info('Validate client payload and input')
        app.validate_client_payload()
        if app.is_valid_client_data:
            logging.info('Client payload and input are valid')
        else:
            logging.error('Client payload and input are NOT valid')
            raise ValueError(app.task_result)

        app.execute()

        app.save_result()

        logging.info('Finished the execution')
    except Exception as e:
        logging.error(f"Error: {e}")
        logging.info(f"PUBLIC_CERT: {cert_pem.decode('utf-8')}")
        # Publish a failure result rather than exiting silently. The trustedzone
        # blocks waiting for this enclave's result; without it that wait runs to
        # its timeout and the whole order stalls with no diagnosis. Note the
        # validation path above RAISES on invalid client data, so without this
        # even a checksum mismatch -- which sets task_code/task_result -- was
        # never reported.
        _report_failure(locals().get('app'), e)
        exit(1)
