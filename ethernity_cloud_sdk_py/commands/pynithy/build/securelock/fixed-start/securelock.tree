# The paths the securelock's fixed start checks (fixed_start.c,
# tree_digest.sh): the directories from which python, started with the fixed
# vector (-I) and HOME=/tmp of securelock.h, loads code, and the files its
# path configuration (getpath) and site open by name.
#
# The entry, its sibling modules and the dApp's serverless package;
# securelock.py puts this directory first on sys.path.
/etny-securelock
# The standard library, lib-dynload and site-packages (the dApp's
# requirements among them), with the .pth files and the sitecustomize site
# reads.
/usr/local/lib/python3.14
# The zip archive sys.path names before the standard library, which the tree
# does not hold.
/usr/local/lib/python314.zip
# Read by name beside the interpreter, /usr/local/bin/python, and not held by
# the tree: the ._pth file that replaces sys.path, pyvenv.cfg in the
# interpreter's directory and in its parent, and the build directory marker.
/usr/local/bin/python._pth
/usr/local/bin/pyvenv.cfg
/usr/local/pyvenv.cfg
/usr/local/bin/pybuilddir.txt
# The standard library's landmarks, searched from the interpreter's directory
# up to /usr (lib/python314.zip, lib/python3.14/os.py): under /usr/local/bin
# and under /usr, which the tree does not hold.
/usr/local/bin/lib
/usr/lib/python314.zip
/usr/lib/python3.14
