# setuptools reads this file by the exact name MANIFEST.in. A case-insensitive
# filesystem also matches MANIFEST.IN; a case-sensitive one does not, and the
# build then ships no ABI, template or script files at all.
include README.md
include LICENSE
recursive-include ethernity_cloud_sdk_py/templates *
recursive-include ethernity_cloud_sdk_py/commands *
exclude .mypy_cache
recursive-exclude * .mypy_cache
# the bytecode of local runs, in every __pycache__
global-exclude *.py[cod]
# never ship the decrypted key-gen source
global-exclude get_sgx_report.c
